# The site under review: any HTML upstream reachable from the caddy container
# (dev server, preview build, staging URL). Caddy proxies it on :8080 and
# injects the c11n overlay script into every HTML response.
C11N_UPSTREAM=http://demo:5173

# How Caddy treats the upstream's TLS certificate:
#   verify   (default) - normal verification; needs a trusted certificate
#   insecure           - skip verification, for https upstreams with a
#                        self-signed cert (e.g. a local vite dev server)
# "insecure" is opt-in and only valid with an https:// upstream; Caddy
# rejects it for plain-http upstreams, so leave the default otherwise.
#
# Leave this variable UNSET rather than empty: Caddy's {$VAR:default} treats an
# empty string as set, so C11N_UPSTREAM_TLS="" would not fall back to "verify".
C11N_UPSTREAM_TLS=verify

# Optional overrides (defaults below match docker-compose.yml)
# C11N_LISTEN=:8080
# C11N_PB_ADDR=pocketbase:8090
# C11N_OVERLAY_DIR=/srv/overlay

# ---- Identity (ADR 0006): invites, magic links, no passwords ----------------
# The first owner. On a fresh database the server creates this account with the
# owner role and prints a single-use sign-in link to its log:
#
#   docker compose logs pocketbase | grep "c11n bootstrap"
#
# There is no password, no sign-up form and no admin UI on the review host, so
# that link is the only way in. Once the owner exists, everyone else is invited
# from the overlay's sidebar.
C11N_OWNER_EMAIL=owner@example.com

# The origin reviewers use. Invite links are absolute URLs built from it.
C11N_PUBLIC_URL=http://localhost:8080

# Invite link lifetime (hours; default 72) and session lifetime (days; 14).
# C11N_LINK_TTL_HOURS=72
# C11N_SESSION_TTL_DAYS=14

# Mark the session cookie Secure. Keep true wherever the review host is https
# (the production answer). Set it to false ONLY for a plain-http stack on a host
# that is not localhost/127.0.0.1: browsers refuse to store a Secure cookie
# there and every sign-in would silently fail. Playwright's Chromium accepts
# Secure cookies on 127.0.0.1, which is why the e2e stack keeps the default.
# C11N_COOKIE_SECURE=true

# Where Caddy serves the static sign-in page from. compose mounts
# ../packages/signin here; the Helm chart (Phase 5) sets it per deployment.
# C11N_SIGNIN_DIR=/srv/signin
