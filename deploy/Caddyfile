{
	order replace after encode

	# No admin API. Caddy's default admin endpoint (localhost:2019) is
	# unauthenticated and address-global, so two instances on one host (a
	# second stack, a dev caddy) would clobber each other's config. Config
	# changes are applied by restarting instead: k8s rolls the pod, and
	# scripts/stack.sh down && up restarts the local stack.
	admin off
}

# Environment values are substituted literally. Caddy's {$VAR:default} uses the
# default only when the variable is UNSET, so an empty value
# (C11N_UPSTREAM_TLS="") counts as set and breaks config load with
# "File to import not found: upstream_tls_". Leave optional variables unset
# rather than empty; stack.sh and compose always pass a real value.
# Upstream TLS handling, selected by $C11N_UPSTREAM_TLS (default: verify).
# "insecure" is opt-in only, for https upstreams with a self-signed cert
# (e.g. a local vite dev server). Caddy rejects it for plain-http upstreams,
# so leave it unset (or "verify") unless your upstream speaks https with a
# certificate the proxy cannot validate.
(upstream_tls_verify) {
}
(upstream_tls_insecure) {
	transport http {
		tls_insecure_skip_verify
	}
}

{$C11N_LISTEN::8080} {
	# PocketBase API + realtime, same-origin under /__c11n/pb/
	handle_path /__c11n/pb/* {
		reverse_proxy {$C11N_PB_ADDR:pocketbase:8090} {
			# SSE: stream responses immediately
			flush_interval -1
		}
	}

	# Overlay bundle
	handle_path /__c11n/* {
		root * {$C11N_OVERLAY_DIR:/srv/overlay}
		file_server
	}

	# The site under review, with script injection
	handle {
		reverse_proxy {$C11N_UPSTREAM:http://demo:5173} {
			# don't let upstream compress; replace needs plaintext
			header_up Accept-Encoding identity
			import upstream_tls_{$C11N_UPSTREAM_TLS:verify}
			# staging-review tradeoff: strip CSP so the injected script runs
			header_down -Content-Security-Policy
		}
		# Only rewrite responses to HTML-document requests, so JS/JSON bodies
		# containing a literal "</head>" are never mangled.
		@html header Accept *text/html*
		replace @html stream {
			`</head>` `<script src="/__c11n/overlay.js" defer></script></head>`
		}
	}
}
