{
  "name": "c11n",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*",
    "e2e"
  ],
  "scripts": {
    "build": "npm run build -w packages/overlay",
    "test": "npm run test -w packages/overlay",
    "lint": "npm run lint --workspaces --if-present",
    "e2e": "npm run build && npm run e2e:vite && npm run e2e:go",
    "e2e:vite": "C11N_FIXTURE=vite npm test -w e2e",
    "e2e:go": "C11N_FIXTURE=go npm test -w e2e"
  }
}
