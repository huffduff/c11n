# The dogfood target (ADR 0009): the sasser-studios `frontend/` app, reviewed
# in Vite dev mode. It is a PRIVATE repo: CI passes a checkout via
# C11N_SASSER_DIR (read-only deploy key), and a bare local run clones
# SASSER_REF into .stack/ using the caller's own git credentials. SASSER_REF is
# a full commit sha and is bumped deliberately: a new commit in that repo must
# never turn CI red unannounced.
SASSER_REPO=huffduff/sasser-studios
SASSER_REF=5ce4f0b1cb8954f40ebe7c7ee8e7a851a987ec1a

# Pinned versions of the native binaries that run the e2e stack.
#
# Sourced by scripts/fetch-tools.sh. Bump a version here and re-run
# scripts/fetch-tools.sh to move the whole stack (local runs and CI) at once.
# REPLACE_RESPONSE_REF is a commit sha, not a tag, so the Caddy build is
# reproducible. XCADDY_VERSION pins the builder itself (@latest would make the
# build depend on whatever upstream shipped that day).
CADDY_VERSION=v2.11.4
XCADDY_VERSION=v0.4.7
REPLACE_RESPONSE_REF=80962887e4c680abfd1b11ce1403fa8cc0fdd3d6
POCKETBASE_VERSION=0.39.11
# sha256 of pocketbase_${POCKETBASE_VERSION}_linux_amd64.zip, taken from the
# release's checksums.txt. scripts/fetch-tools.sh refuses to install a
# download that does not match it.
POCKETBASE_SHA256_LINUX_AMD64=08b9fcda0d5fd42cb315dc15a36dfa121c993855bd635f01d347c31b4328ec34
# Same, for arm64. Not fetched by fetch-tools.sh (the e2e stack is amd64-only
# here); deploy/pocketbase/Dockerfile builds for both and takes its checksums
# from the same release's checksums.txt, so it is pinned in the one place the
# image and the tests both read.
POCKETBASE_SHA256_LINUX_ARM64=8c785618840df7ebba795fdf4eba33a5fed64ac5307ad8023b955b4ebb82048b
